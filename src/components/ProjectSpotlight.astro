---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import AssembleTitle from './AssembleTitle.astro';
import { type Locale, pathFor } from '../i18n/routes';
import { t, formatMonthYear } from '../i18n/ui';
import type { SteamReviews } from '../data/steam';

interface Props {
  project: CollectionEntry<'projects'>;
  locale: Locale;
  reviews?: SteamReviews | null;
}

const { project, locale, reviews } = Astro.props;
const { data } = project;
const ui = t(locale);
const href = pathFor({ page: 'project', slug: project.id }, locale);
const facts = data.facts.filter((f) => f.label.en !== 'Genre').slice(0, 2);
const storeLinks = data.links.filter((l) => l.kind === 'steam' || l.kind === 'itch');
---

<article class="spot panel" aria-labelledby={`spot-${project.id}`}>
  <div class="spot__media" data-player>
    <Image
      class="spot__cover"
      src={data.cover}
      alt={data.coverAlt[locale]}
      widths={[640, 960, 1280, 1920]}
      sizes="(min-width: 64rem) 44rem, 100vw"
      loading="lazy"
    />
    {
      data.video && (
        <>
          <video
            class="spot__video"
            muted
            loop
            playsinline
            preload="none"
            poster={data.video.poster.src}
            hidden
            data-video
          >
            {data.video.webm && <source src={data.video.webm} type="video/webm" />}
            {data.video.mp4 && <source src={data.video.mp4} type="video/mp4" />}
          </video>
          <button
            class="pill pill--primary spot__play"
            type="button"
            data-toggle
            data-label-play={ui.projects.watch}
            data-label-pause={ui.projects.pause}
            aria-pressed="false"
          >
            <Icon name="play" />
            <span data-label>{ui.projects.watch}</span>
          </button>
        </>
      )
    }
  </div>

  <div class="spot__info">
    <AssembleTitle id={`spot-${project.id}`} text={data.title} class="spot__title" />
    <p class="spot__summary">{data.summary[locale]}</p>

    <dl class="spot__facts">
      <div>
        <dt>{data.status === 'released' && data.released ? ui.projects.released : ui.projects.statusLabel}</dt>
        <dd class="num">
          {data.status === 'released' && data.released
            ? formatMonthYear(data.released, locale)
            : ui.projects.status[data.status]}
        </dd>
      </div>
      {
        facts.map((f) => (
          <div>
            <dt>{f.label[locale]}</dt>
            <dd class="num">{f.value[locale]}</dd>
          </div>
        ))
      }
      {
        reviews && (
          <div>
            <dt>{ui.projects.reviews}</dt>
            <dd class="num">{ui.projects.reviewsValue(reviews.percent, reviews.total)}</dd>
          </div>
        )
      }
    </dl>

    <div class="actions">
      <a class="pill pill--primary" href={href}>
        {ui.projects.view(data.title)}
        <Icon name="arrow-right" />
      </a>
      {
        storeLinks.map((l) => (
          <a
            class="pill pill--secondary"
            href={l.url}
            target="_blank"
            rel="noopener"
            aria-label={ui.links.on(data.title, ui.links[l.kind])}
          >
            <Icon name={l.kind === 'steam' ? 'steam' : 'itch'} />
            {ui.links[l.kind]}
          </a>
        ))
      }
    </div>
  </div>
</article>

<script>
  document.querySelectorAll<HTMLElement>('[data-player]').forEach((player) => {
    const video = player.querySelector<HTMLVideoElement>('[data-video]');
    const toggle = player.querySelector<HTMLButtonElement>('[data-toggle]');
    const label = toggle?.querySelector<HTMLElement>('[data-label]');
    if (!video || !toggle || !label) return;
    toggle.addEventListener('click', () => {
      const playing = toggle.getAttribute('aria-pressed') === 'true';
      if (playing) {
        video.pause();
        toggle.setAttribute('aria-pressed', 'false');
        label.textContent = toggle.dataset.labelPlay ?? '';
      } else {
        video.hidden = false;
        player.classList.add('is-playing');
        video.play().catch(() => {});
        toggle.setAttribute('aria-pressed', 'true');
        label.textContent = toggle.dataset.labelPause ?? '';
      }
    });
  });
</script>

<style>
  .spot {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    overflow: hidden;
  }

  .spot__media {
    position: relative;
    min-block-size: 22rem;
    background: var(--panel-2);
    overflow: hidden;
  }

  .spot__cover,
  .spot__video {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  .spot__cover {
    object-position: 45% 50%;
  }

  .spot__video {
    opacity: 0;
    transition: opacity 300ms ease;
  }

  .spot__media:global(.is-playing) .spot__video {
    opacity: 1;
  }

  /* The logo's shine crosses the scene when you point at the project. */
  .spot__media::after {
    content: '';
    position: absolute;
    inset: -10%;
    background: linear-gradient(
      63deg,
      transparent 38%,
      rgb(255 255 255 / 0.12) 48%,
      rgb(255 255 255 / 0.22) 52%,
      transparent 58%
    );
    transform: translateX(-80%);
    pointer-events: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .spot:hover .spot__media::after {
      transform: translateX(80%);
      transition: transform 900ms var(--ease-in-out);
    }
  }

  .spot__play {
    position: absolute;
    inset-inline-start: 1rem;
    inset-block-end: 1rem;
    z-index: 1;
    box-shadow: 0 8px 24px -8px rgb(0 8 10 / 0.8);
  }

  .spot__info {
    display: grid;
    align-content: center;
    gap: 1.1rem;
    padding: clamp(1.5rem, 3vw, 2.5rem);
  }

  .spot__summary {
    color: var(--text-2);
    max-inline-size: 46ch;
  }

  .spot__facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10.5rem, 1fr));
    gap: 0.75rem 1.25rem;
    padding-block: 1rem;
    border-block: 1px solid var(--line);
  }

  .spot__facts dt {
    font-size: var(--step--1);
    color: var(--text-3);
  }

  .spot__facts dd {
    font-weight: 600;
    line-height: 1.35;
    text-wrap: balance;
  }

  .actions {
    padding-block-start: 0.25rem;
  }

  @media (max-width: 63.99rem) {
    .spot {
      grid-template-columns: 1fr;
    }

    .spot__media {
      min-block-size: 0;
      aspect-ratio: 16 / 9;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .spot__media::after {
      display: none;
    }
  }
</style>
