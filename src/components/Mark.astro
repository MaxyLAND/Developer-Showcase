---
/** The static MaxyLAND hexagon (M + L), filled with the brand gradient. */
interface Props {
  size?: number;
  class?: string;
}
const { size = 32, class: className = '' } = Astro.props;
const uid = `mk${Math.random().toString(36).slice(2, 8)}`;
---

<svg
  class={`mark-static ${className}`}
  width={size}
  height={size}
  viewBox="0 0 1380 1380"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient id={uid} gradientUnits="userSpaceOnUse" x1="-82" y1="1272" x2="1462" y2="108">
      <stop offset="0.26" stop-color="#23ebe9"></stop>
      <stop offset="0.70" stop-color="#67d45f"></stop>
      <stop offset="0.96" stop-color="#ebfa56"></stop>
    </linearGradient>
  </defs>
  <path
    fill={`url(#${uid})`}
    d="m418.6 1097.5l-217.5-125.5v-564l488.5-282 54 31.2v940.6l326.1-188.3v-126l-217.1 125.4v-814.8l-163-94.1-597.6 345v690l326.6 188.5z"
  ></path>
  <path
    fill={`url(#${uid})`}
    d="m960.6 156.5l326.5 188.5v690l-597.5 345-163-94.1v-745.8l-61.5 126-46.5-63.6v370l-109.2-63v-439l109.1-63 46.5 63.6 61.6-126.1 109-62.8v940.6l54 31.2 488.4-282v-564l-217.4-125.5z"
  ></path>
</svg>
