---
import Mark from './Mark.astro';
import { type Locale, type Route, pathFor } from '../i18n/routes';
import { t } from '../i18n/ui';

interface Props {
  locale: Locale;
  route: Route;
}

const { locale, route } = Astro.props;
const ui = t(locale);
const home = pathFor({ page: 'home' }, locale);
const onHome = route.page === 'home';
const anchor = (id: string) => (onHome ? `#${id}` : `${home}#${id}`);
const sections = [
  { id: 'about', label: ui.nav.about },
  { id: 'projects', label: ui.nav.projects },
  { id: 'tools', label: ui.nav.tools },
  { id: 'contact', label: ui.nav.contact },
];
---

<header class="toolbar" data-enter>
  <div class="toolbar__inner">
    <a class="brand" href={home} aria-label={ui.nav.home}>
      <Mark size={30} />
      <span class="brand__name" aria-hidden="true">MaxyLAND</span>
    </a>

    <nav class="tabs" aria-label={ui.nav.label}>
      <ul>
        {
          sections.map((s) => (
            <li>
              <a class="pill pill--ghost" href={anchor(s.id)} data-spy={onHome ? s.id : undefined}>
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="lang" role="group" aria-label={ui.lang.label}>
      {
        (['en', 'es'] as const).map((code) =>
          code === locale ? (
            <span class="lang__item lang__item--current" aria-current="true" lang={code}>
              {code.toUpperCase()}
            </span>
          ) : (
            <a
              class="lang__item lang__item--link"
              href={pathFor(route, code)}
              hreflang={code}
              lang={code}
              data-set-lang={code}
              aria-label={ui.lang.switchTo}
            >
              {code.toUpperCase()}
            </a>
          ),
        )
      }
    </div>
  </div>
</header>

<script>
  // Remember a manual language choice; .htaccess and the head script honor it.
  document.querySelectorAll<HTMLAnchorElement>('[data-set-lang]').forEach((link) => {
    link.addEventListener('click', () => {
      document.cookie = `lang=${link.dataset.setLang}; path=/; max-age=31536000; SameSite=Lax`;
    });
  });

  // Fade the tab row's edge only when it actually scrolls.
  const tabRow = document.querySelector<HTMLElement>('.tabs');
  if (tabRow) {
    const check = () => tabRow.classList.toggle('is-overflowing', tabRow.scrollWidth > tabRow.clientWidth + 1);
    new ResizeObserver(check).observe(tabRow);
  }

  // Mark the section in view (home only).
  const tabs = new Map<string, HTMLElement>();
  document.querySelectorAll<HTMLElement>('[data-spy]').forEach((a) => tabs.set(a.dataset.spy!, a));
  if (tabs.size) {
    const visible = new Map<string, number>();
    const update = () => {
      let best: string | null = null;
      let bestRatio = 0;
      visible.forEach((ratio, id) => {
        if (ratio > bestRatio) {
          best = id;
          bestRatio = ratio;
        }
      });
      tabs.forEach((a, id) => a.setAttribute('aria-current', String(id === best)));
    };
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => visible.set(e.target.id, e.isIntersecting ? e.intersectionRatio : 0));
        update();
      },
      { rootMargin: '-35% 0px -45% 0px', threshold: [0, 0.25, 0.5, 0.75, 1] },
    );
    tabs.forEach((_, id) => {
      const el = document.getElementById(id);
      if (el) io.observe(el);
    });
  }
</script>

<style>
  .toolbar {
    position: sticky;
    inset-block-start: 0;
    z-index: 50;
    background: rgb(13 18 21 / 0.94);
    border-block-end: 1px solid var(--line);
  }

  .toolbar__inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.75rem 1rem;
    inline-size: min(100% - 2 * var(--gutter), var(--page));
    min-block-size: 4rem;
    margin-inline: auto;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    border-radius: var(--r-chip);
  }

  .brand__name {
    font-family: var(--font-display);
    font-size: 1.25rem;
    letter-spacing: 0.01em;
    color: var(--text);
  }

  .tabs ul {
    display: flex;
    justify-content: center;
    gap: 0.25rem;
  }

  .lang {
    display: inline-flex;
    align-items: center;
    padding: 3px;
    border: 1px solid var(--line-2);
    border-radius: var(--r-pill);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1;
  }

  .lang__item {
    display: inline-grid;
    place-items: center;
    min-inline-size: 2.5rem;
    block-size: 2.125rem;
    border-radius: var(--r-pill);
  }

  /* Current language wears the same tint as the current tab. */
  .lang__item--current {
    color: var(--cyan);
    background: var(--cyan-tint-2);
  }

  .lang__item--link {
    color: var(--cyan);
    text-decoration: none;
    transition:
      transform 160ms var(--ease-out),
      background-color 200ms ease;
  }

  .lang__item--link:active {
    transform: scale(0.95);
  }

  @media (hover: hover) and (pointer: fine) {
    .lang__item--link:hover {
      background: var(--cyan-tint);
    }
  }

  /* Narrow: tabs drop to their own row; it scrolls only on very small screens. */
  @media (max-width: 47.99rem) {
    .toolbar__inner {
      grid-template-columns: 1fr auto;
      padding-block-start: 0.5rem;
    }

    .tabs {
      grid-column: 1 / -1;
      grid-row: 2;
      margin-inline: calc(var(--gutter) * -1);
      overflow-x: auto;
      scrollbar-width: none;
      overscroll-behavior-x: contain;
    }

    /* Only when the tabs really overflow: fade the edge to show there is more. */
    .tabs:global(.is-overflowing) {
      mask-image: linear-gradient(90deg, #000 calc(100% - 1.5rem), transparent);
    }

    .tabs::-webkit-scrollbar {
      display: none;
    }

    .tabs ul {
      justify-content: space-between;
      gap: 0;
      min-inline-size: 100%;
      inline-size: max-content;
      padding: 0 0.75rem 0.5rem;
    }

    .tabs :global(.pill--ghost) {
      --pill-h: 2.5rem;
      padding: 0 0.55em;
      font-size: 0.9375rem;
    }
  }

  @media (max-width: 23.99rem) {
    .tabs ul {
      padding-inline: 0.5rem;
    }

    .tabs :global(.pill--ghost) {
      padding: 0 0.45em;
      font-size: 0.875rem;
    }
  }
</style>
