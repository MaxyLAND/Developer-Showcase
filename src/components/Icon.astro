---
/** Phosphor (regular) for UI glyphs, Simple Icons for brand logos. */
import arrowRight from '@phosphor-icons/core/assets/regular/arrow-right.svg?raw';
import arrowLeft from '@phosphor-icons/core/assets/regular/arrow-left.svg?raw';
import arrowUpRight from '@phosphor-icons/core/assets/regular/arrow-up-right.svg?raw';
import caretLeft from '@phosphor-icons/core/assets/regular/caret-left.svg?raw';
import caretRight from '@phosphor-icons/core/assets/regular/caret-right.svg?raw';
import check from '@phosphor-icons/core/assets/regular/check.svg?raw';
import copy from '@phosphor-icons/core/assets/regular/copy.svg?raw';
import envelope from '@phosphor-icons/core/assets/regular/envelope-simple.svg?raw';
import lifebuoy from '@phosphor-icons/core/assets/regular/lifebuoy.svg?raw';
import play from '@phosphor-icons/core/assets/regular/play.svg?raw';
import puzzle from '@phosphor-icons/core/assets/regular/puzzle-piece.svg?raw';
import wrench from '@phosphor-icons/core/assets/regular/wrench.svg?raw';
import gamepad from '@phosphor-icons/core/assets/regular/game-controller.svg?raw';
import close from '@phosphor-icons/core/assets/regular/x.svg?raw';
import expand from '@phosphor-icons/core/assets/regular/corners-out.svg?raw';
import steam from 'simple-icons/icons/steam.svg?raw';
import itch from 'simple-icons/icons/itchdotio.svg?raw';
import github from 'simple-icons/icons/github.svg?raw';
import xLogo from 'simple-icons/icons/x.svg?raw';

const icons = {
  'arrow-right': arrowRight,
  'arrow-left': arrowLeft,
  'arrow-up-right': arrowUpRight,
  'caret-left': caretLeft,
  'caret-right': caretRight,
  check,
  copy,
  envelope,
  lifebuoy,
  play,
  puzzle,
  wrench,
  gamepad,
  close,
  expand,
  steam,
  itch,
  github,
  x: xLogo,
} as const;

export type IconName = keyof typeof icons;

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 18, class: className = '' } = Astro.props;
const svg = icons[name]
  .replace(/<title>.*?<\/title>/, '')
  .replace(/ role="img"/, '')
  .replace(/ fill="currentColor"/, '')
  .replace(
    '<svg',
    `<svg width="${size}" height="${size}" fill="currentColor" aria-hidden="true" focusable="false" class="icon ${className}"`,
  );
---

<Fragment set:html={svg} />
